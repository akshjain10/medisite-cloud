# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharma_sites

# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Root domain of the platform. Tenant subdomains are <slug>.<PLATFORM_DOMAIN>.
# In development, *.localhost resolves to your machine in most browsers.
PLATFORM_DOMAIN=localhost
